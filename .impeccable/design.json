  "components": [
    {
      "name": "Touch Button",
      "kind": "button",
      "refersTo": "button-touch",
      "description": "Outlined blue touch point: every pressable action.",
      "html": "<button class=\"ds-touch\">OPEN READINGS</button>",
      "css": ".ds-touch{background:transparent;color:#2159C4;border:1.5px solid #2159C4;border-radius:6px;height:48px;padding:0 16px;font:600 15px 'Barlow Condensed',sans-serif;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;transition:background .15s}.ds-touch:hover{background:rgba(33,89,196,.08)}.ds-touch:active{background:rgba(33,89,196,.22)}.ds-touch:focus-visible{outline:2px solid #2159C4;outline-offset:2px}"
    },
    {
      "name": "LCD (fault)",
      "kind": "custom",
      "refersTo": "lcd-needs-you",
      "description": "Two-line 20-column dot-matrix verdict; amber backlight when anything needs you.",
      "html": "<div class=\"ds-lcd\"><div class=\"ds-lcd-glass\"><span class=\"ds-lcd-inv\">FAULT:</span> SERVICES<br>0/2 PORTS UP</div></div>",
      "css": ".ds-lcd{background:#101214;border-radius:6px;padding:6px;max-width:360px}.ds-lcd-glass{background:#E9A21C;color:#2B1B02;border-radius:3px;padding:10px 12px;font:700 18px/1.3 'Courier New',monospace;letter-spacing:.12em;text-transform:uppercase}.ds-lcd-inv{background:#2B1B02;color:#E9A21C}"
    },
    {
      "name": "LCD (healthy)",
      "kind": "custom",
      "refersTo": "lcd-healthy",
      "description": "Blue backlight: nothing is CHECK or FAULT.",
      "html": "<div class=\"ds-lcd2\"><div class=\"ds-lcd2-glass\">SYSTEM OK<br>BATT 25C  100%</div></div>",
      "css": ".ds-lcd2{background:#101214;border-radius:6px;padding:6px;max-width:360px}.ds-lcd2-glass{background:#2F63C9;color:#EAF2FF;border-radius:3px;padding:10px 12px;font:700 18px/1.3 'Courier New',monospace;letter-spacing:.12em}"
    },
    {
      "name": "Bay",
      "kind": "card",
      "refersTo": "bay",
      "description": "Inset drive-caddy bay: LED, silkscreen label, chevron, tabular reading, detail and state word.",
      "html": "<button class=\"ds-bay\"><span class=\"ds-bay-top\"><span class=\"ds-led ds-led-bad\"></span><span class=\"ds-bay-label\">SERVICES</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#454E57\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 9.5l5 5 5-5\"/></svg></span><span class=\"ds-bay-reading\">0/2</span><span class=\"ds-bay-foot\"><span>ports up</span><b class=\"ds-bay-word\">FAULT</b></span></button>",
      "css": ".ds-bay{display:flex;flex-direction:column;gap:6px;width:180px;min-height:100px;text-align:left;background:#C9CFD4;border:0;border-radius:6px;padding:12px 8px 12px 12px;box-shadow:inset 0 2px 0 #9FA7AE,0 1px 0 #EEF1F3;cursor:pointer}.ds-bay:focus-visible{outline:2px solid #2159C4}.ds-bay:hover{background:#C3C9CE}.ds-bay-top{display:flex;align-items:center;gap:8px}.ds-bay-label{flex:1;font:600 14px 'Barlow Condensed',sans-serif;letter-spacing:.07em;color:#454E57}.ds-bay-reading{font:500 22px Roboto,sans-serif;font-variant-numeric:tabular-nums;color:#1B1F24}.ds-bay-foot{display:flex;justify-content:space-between;font:400 13px Roboto,sans-serif;color:#454E57}.ds-bay-word{font:600 13px 'Barlow Condensed',sans-serif;letter-spacing:.07em;color:#9E2218}.ds-led{width:12px;height:12px;border-radius:50%;flex:none;box-shadow:inset 0 0 0 1px rgba(0,0,0,.25)}.ds-led-bad{background:repeating-linear-gradient(-45deg,#CC3326 0 2.5px,rgba(0,0,0,.45) 2.5px 4px)}"
    },
    {
      "name": "Panel Row",
      "kind": "custom",
      "refersTo": "row",
      "description": "LED, label, right-aligned tabular value, state word under it for CHECK/FAULT.",
      "html": "<div class=\"ds-panel\"><div class=\"ds-row\"><span class=\"ds-rled\"></span><span class=\"ds-rlabel\">Temperature</span><span class=\"ds-rval\">41.0 °C · warm<br><b>CHECK</b></span></div></div>",
      "css": ".ds-panel{background:#C9CFD4;border-radius:6px;padding:6px 14px;box-shadow:inset 0 2px 0 #9FA7AE,0 1px 0 #EEF1F3;max-width:360px}.ds-row{display:flex;align-items:center;min-height:44px;padding:8px 0;gap:12px}.ds-rled{width:12px;height:12px;border-radius:50%;background:repeating-linear-gradient(-45deg,#D9930C 0 3.5px,rgba(0,0,0,.45) 3.5px 5px)}.ds-rlabel{flex:1;font:400 15px Roboto,sans-serif;color:#1B1F24}.ds-rval{text-align:right;font:500 15px Roboto,sans-serif;font-variant-numeric:tabular-nums;color:#1B1F24}.ds-rval b{font:600 11px 'Barlow Condensed',sans-serif;letter-spacing:.07em}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Four equal destinations; active gets the tonal pill.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-i ds-on\" href=\"#\"><span class=\"ds-pill\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 10.5h10M7 14h6\"/></svg></span>Status</a><a class=\"ds-nav-i\" href=\"#\"><span class=\"ds-pill\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4.5 11a8.9 8.9 0 0 1 15 0\"/><path d=\"M12 14l4.5-5\"/></svg></span>Readings</a></nav>",
